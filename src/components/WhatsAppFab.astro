---
import { company } from '../data/company';

const message = encodeURIComponent(company.contact.whatsappDefaultMessage);
const href = `https://api.whatsapp.com/send?phone=${company.contact.whatsapp}&text=${message}`;
---

<a class="whatsapp-fab" href={href} target="_blank" rel="noopener noreferrer" aria-label="Escribir a Automotor por WhatsApp">
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.6Z"/>
    <path d="M9 8.5c.5 2.7 2 4.2 4.7 5"/>
  </svg>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 45;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: #1d9b55;
    color: #fff;
    box-shadow: 0 12px 26px rgba(19, 100, 58, 0.22);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .whatsapp-fab:hover { transform: translateY(-2px); background: #178048; }
  .whatsapp-fab .icon { width: 25px; height: 25px; }
  :global(body.menu-open) .whatsapp-fab { visibility: hidden; }
  @media (max-width: 680px) {
    .whatsapp-fab { width: 52px; height: 52px; border-radius: 16px; }
  }
</style>
