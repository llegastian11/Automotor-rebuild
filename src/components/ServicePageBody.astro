---
import ServiceQuoteForm from './ServiceQuoteForm.astro';
import { featureText, insurancePartners, gpsPartner, type ServiceSlug } from '../data/services';

interface Props {
  slug: ServiceSlug;
  title: string;
  serviceName: string;
}
const { slug, title, serviceName } = Astro.props;
const features = featureText[slug];
const isGps = slug === 'gps-vehicular';
---

<section class="section service-page">
  <div class="container service-layout">
    <div class="service-copy">
      <p class="eyebrow">Servicio Automotor</p>
      <h1 class="section-title">{title}</h1>
      <div class="service-tags">{features.map((text) => <strong>{text}</strong>)}</div>

      <div class="partner-block">
        {isGps ? (
          <>
            <span>Aliado GPS</span>
            <h2>GPS vehicular con {gpsPartner.name}</h2>
            <p>{gpsPartner.description}</p>
            <a class="partner-cta" href={gpsPartner.url} target="_blank" rel="noreferrer">Ver {gpsPartner.product}</a>
            <div class="partner-list">{gpsPartner.features.map((f) => <strong>{f}</strong>)}</div>
          </>
        ) : (
          <>
            <span>Aseguradoras</span>
            <h2>Trabajamos con aseguradoras de confianza</h2>
            <p>Podemos orientar la cotización con opciones de aseguradoras reconocidas.</p>
            <div class="partner-list">{insurancePartners.map((name) => <strong>{name}</strong>)}</div>
          </>
        )}
      </div>
    </div>
    <ServiceQuoteForm serviceName={serviceName} />
  </div>
</section>

<style>
  .service-page { background: linear-gradient(145deg, var(--paper), #fff); }
  .service-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: start; }
  .service-copy { position: sticky; top: 100px; }
  .service-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .service-tags strong { padding: 8px 12px; border-radius: 999px; background: var(--surface-secondary); font-size: 11px; font-weight: 700; }

  .partner-block { margin-top: 32px; padding: 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .partner-block span { display: block; margin-bottom: 8px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .partner-block h2 { margin: 0 0 8px; font: 700 17px var(--font-display); }
  .partner-block p { margin: 0 0 14px; color: var(--muted); font-size: 12.5px; line-height: 1.55; }
  .partner-cta { display: inline-block; margin-bottom: 14px; color: var(--red); font-weight: 700; font-size: 13px; }
  .partner-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .partner-list strong { padding: 8px 11px; border-radius: 8px; background: var(--surface-secondary); font-size: 12px; }

  @media (max-width: 980px) {
    .service-layout { grid-template-columns: 1fr; gap: 34px; }
    .service-copy { position: static; }
  }
</style>
