---
import { sourceGroups } from '../data/services';
---

<div class="sources-toolbar">
  <label class="sr-only" for="sourceSearch">Buscar fuente</label>
  <input class="source-search" id="sourceSearch" type="search" placeholder="Buscar entidad, ciudad o información" />
  <label class="sr-only" for="sourceFilter">Filtrar categoría</label>
  <select class="source-filter" id="sourceFilter">
    <option value="all">Todas las categorías</option>
    <option value="identidad">Propiedad y registro</option>
    <option value="multas">Multas y papeletas</option>
    <option value="tecnico">Estado técnico y seguros</option>
    <option value="seguridad">Documentos y seguridad</option>
  </select>
</div>
<div class="source-empty" id="sourceEmpty">No encontramos fuentes con esos criterios.</div>

<div class="source-groups">
  {sourceGroups.map((group) => (
    <article class:list={['source-group', { wide: group.wide }]} data-category={group.category}>
      <header class="source-group-head">
        <h3>{group.title}</h3>
        <span>{group.countLabel}</span>
      </header>
      <div class="source-items">
        {group.items.map((item) => (
          <div class:list={['source-item', { 'requires-account': item.requiresAccount }]}>
            <span class="source-mark">{item.mark}</span>
            <div>
              <strong>{item.name}</strong>
              <small>{item.detail}</small>
              {item.requiresAccount && <span class="source-access">Requiere cuenta SUNARP</span>}
            </div>
            {item.link ? (
              <a class="source-action" href={item.link} target="_blank" rel="noopener noreferrer" aria-label={`Abrir fuente para ${item.name}`}>Consultar ↗</a>
            ) : (
              <span class="source-action source-unavailable" aria-label={`${item.name}: Automotor.pe no publica actualmente un enlace externo`}>No disponible</span>
            )}
          </div>
        ))}
      </div>
    </article>
  ))}
</div>

<style>
  .sources-toolbar { display: flex; gap: 10px; margin: 38px 0 10px; }
  .source-search { flex: 1; min-width: 0; min-height: 50px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 0 16px; }
  .source-filter { flex: 0 1 220px; min-width: 0; min-height: 50px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 0 14px; }
  .source-empty { display: none; padding: 30px; border: 1px dashed var(--line); border-radius: 16px; text-align: center; color: var(--muted); }
  .source-empty.visible { display: block; }

  .source-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 24px; }
  .source-group { overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: #fff; }
  .source-group[hidden] { display: none; }
  .source-group.wide { grid-column: 1 / -1; }
  .source-group-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 22px; border-bottom: 1px solid var(--line); }
  .source-group-head h3 { margin: 0; font: 600 17px var(--font-display); }
  .source-group-head span { color: #99979a; font: 600 11px var(--font-mono); }
  .source-items { display: grid; grid-template-columns: 1fr 1fr; }
  .source-group.wide .source-items { grid-template-columns: repeat(3, 1fr); }
  .source-item {
    position: relative; display: flex; align-items: center; gap: 12px;
    min-height: 66px; padding: 13px 82px 13px 18px; border-bottom: 1px solid #ece9e5;
  }
  .source-item[hidden] { display: none; }
  .source-mark { display: grid; width: 34px; height: 34px; flex: 0 0 34px; place-items: center; border: 1px solid #ddd9d4; border-radius: 9px; background: #faf9f7; color: var(--red); font: 700 10px var(--font-display); }
  .source-item strong { display: block; font-size: 12px; line-height: 1.35; }
  .source-item small { display: block; margin-top: 3px; color: #969498; font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; }
  .source-access { display: inline-flex; margin-top: 6px; padding: 3px 6px; border-radius: 999px; background: var(--red-light); color: var(--red); font-size: 7px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .source-action { position: absolute; right: 12px; top: 50%; padding: 6px 7px; transform: translateY(-50%); border: 1px solid var(--line); border-radius: 7px; color: var(--red); font-size: 9px; font-weight: 750; transition: background 0.18s ease, color 0.18s ease; }
  .source-action:hover { background: var(--red); color: #fff; }
  .source-unavailable { border-style: dashed; color: var(--muted); cursor: not-allowed; }
  .source-unavailable:hover { background: transparent; color: var(--muted); }

  @media (max-width: 820px) {
    .source-groups { grid-template-columns: 1fr; }
    .source-group.wide .source-items { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .source-items, .source-group.wide .source-items { grid-template-columns: 1fr; }
    .sources-toolbar { flex-direction: column; }
    .source-filter { flex-basis: auto; width: 100%; }
  }
</style>

<script>
  const search = document.getElementById('sourceSearch') as HTMLInputElement | null;
  const filter = document.getElementById('sourceFilter') as HTMLSelectElement | null;
  const empty = document.getElementById('sourceEmpty');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.source-group'));

  function apply() {
    const term = (search?.value || '').trim().toLowerCase();
    const category = filter?.value || 'all';
    let visible = 0;
    groups.forEach((group) => {
      const categoryMatch = category === 'all' || group.dataset.category === category;
      let groupVisible = 0;
      group.querySelectorAll<HTMLElement>('.source-item').forEach((item) => {
        const show = categoryMatch && item.textContent!.toLowerCase().includes(term);
        item.hidden = !show;
        if (show) groupVisible += 1;
      });
      group.hidden = groupVisible === 0;
      visible += groupVisible;
    });
    empty?.classList.toggle('visible', visible === 0);
  }

  search?.addEventListener('input', apply);
  filter?.addEventListener('change', apply);
</script>
