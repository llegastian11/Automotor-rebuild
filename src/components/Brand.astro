---
import { withBase } from '../utils/url';

interface Props {
  href?: string;
  compact?: boolean;
}
const { href = '/', compact = false } = Astro.props;
---

<a class:list={['brand', { compact }]} href={href} aria-label="Automotor.pe, ir a inicio">
  <img src={withBase('/automotor-logo.png')} alt="Automotor.pe" width="220" height="40" />
</a>

<style>
  .brand { display: inline-flex; align-items: center; }
  .brand img { height: 30px; width: auto; }
  .brand.compact img { height: 26px; }
</style>
