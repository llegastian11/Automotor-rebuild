---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
import { posts, pages, formatDate, entryDescription, entryImage, SERVICE_SLUGS, type ContentEntry } from '../data/content';
import { rewriteContentHtml } from '../utils/rewriteContent';

export function getStaticPaths() {
  const entries: ContentEntry[] = [...posts, ...pages].filter(
    (entry) => entry.path !== '/' && !(SERVICE_SLUGS as readonly string[]).includes(entry.slug)
  );
  return entries.map((entry) => ({
    params: { path: entry.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: ContentEntry };
const isPost = entry.type === 'post';
const contentHtml = rewriteContentHtml(entry.contentHtml);
const related = posts.filter((post) => post.id !== entry.id).slice(0, 5);
---

<BaseLayout title={`${entry.title} | Automotor.pe`} description={entryDescription(entry)} ogImage={entryImage(entry)} type={isPost ? 'article' : 'website'}>
  <section class="section entry-layout">
    <div class="container entry-grid">
      <article class="entry">
        <a class="back-link" href={withBase(isPost ? '/archivo/' : '/')}>← Volver</a>
        {entry.featuredMedia?.url && <img class="entry-image" src={withBase(entry.featuredMedia.url)} alt={entry.featuredMedia.alt || entry.title} width="900" height="500" />}
        <header class="entry-head">
          <span>{isPost ? entry.category : 'Página'}</span>
          <h1>{entry.title}</h1>
          <p>{isPost ? formatDate(entry.date) : `Actualizado: ${formatDate(entry.modified)}`}</p>
        </header>
        <div class="entry-content" set:html={contentHtml} />
      </article>
      <aside class="entry-side">
        <h2>Más contenido</h2>
        {related.map((post) => (
          <a href={withBase(post.path)}>{post.title}<small>{post.category}</small></a>
        ))}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .entry-grid { display: grid; grid-template-columns: 1fr 320px; gap: 50px; align-items: start; }
  .entry-grid > * { min-width: 0; }
  .back-link { display: inline-block; margin-bottom: 20px; color: var(--red); font-weight: 700; font-size: 13px; }
  .entry-image { width: 100%; height: 340px; object-fit: cover; border-radius: 20px; margin-bottom: 28px; }
  .entry-head span { color: var(--red); font: 700 10px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .entry-head h1 { margin: 12px 0 8px; font: 700 clamp(1.8rem, 3.2vw, 2.5rem)/1.15 var(--font-display); letter-spacing: -0.03em; }
  .entry-head p { margin: 0; color: var(--muted); font-size: 13px; }
  .entry-content { margin-top: 30px; color: #2b2b2b; font-size: 16px; line-height: 1.8; overflow-wrap: break-word; }
  .entry-content :global(img) { max-width: 100%; height: auto; border-radius: 14px; }
  .entry-content :global(h2) { font: 700 22px var(--font-display); margin: 34px 0 12px; }
  .entry-content :global(h3) { font: 700 18px var(--font-display); margin: 26px 0 10px; }
  .entry-content :global(p) { margin: 0 0 18px; }
  .entry-content :global(a) { color: var(--red); text-decoration: underline; overflow-wrap: break-word; }
  .entry-content :global(ul), .entry-content :global(ol) { margin: 0 0 18px; padding-left: 22px; }
  .entry-content :global(blockquote) { margin: 0 0 18px; padding: 14px 20px; border-left: 3px solid var(--red); background: var(--surface-secondary); border-radius: 0 12px 12px 0; }
  .entry-content :global(table) { max-width: 100%; }
  .entry-content :global(.table-wrap),
  .entry-content :global(table) { display: block; overflow-x: auto; }
  .entry-content :global(pre) { max-width: 100%; overflow-x: auto; }
  .entry-content :global(iframe) { max-width: 100%; }

  .entry-side { position: sticky; top: 100px; padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .entry-side h2 { margin: 0 0 14px; font: 700 15px var(--font-display); }
  .entry-side a { display: block; padding: 10px 0; border-top: 1px solid var(--line); font-size: 13px; font-weight: 600; color: var(--ink); }
  .entry-side a:first-of-type { border-top: 0; }
  .entry-side a:hover { color: var(--red); }
  .entry-side small { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }

  @media (max-width: 980px) {
    .entry-grid { grid-template-columns: 1fr; }
    .entry-side { position: static; }
  }
</style>
