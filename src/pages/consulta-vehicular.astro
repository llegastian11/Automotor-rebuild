---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCatalog from '../components/SourceCatalog.astro';
---

<BaseLayout
  title="Consulta vehicular por placa en Perú | Automotor.pe"
  description="40+ consultas gratuitas agrupadas en 8 categorías: propiedad, multas, SOAT, revisión técnica, historial y documentos vehiculares en Perú."
>
  <section class="section sources-catalog">
    <div class="container">
      <div class="sources-intro">
        <div>
          <p class="eyebrow">Consulta vehicular gratuita</p>
          <h1 class="section-title">La información detrás de cada placa.</h1>
        </div>
        <div>
          <p class="section-copy">Centralizamos consultas públicas y especializadas para revisar propiedad, deudas, seguros, inspecciones, antecedentes y papeletas en distintas regiones del Perú.</p>
          <div class="sources-summary">
            <div><strong>40+</strong><span>consultas gratuitas</span></div>
            <div><strong>8</strong><span>grupos de información</span></div>
            <div><strong>1</strong><span>placa para comenzar</span></div>
          </div>
        </div>
      </div>
      <SourceCatalog />
    </div>
  </section>
</BaseLayout>

<style>
  .sources-catalog { max-width: 1180px; margin: 0 auto; padding-top: 56px; }
  .sources-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: start; }
  .sources-summary { display: flex; gap: 30px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); }
  .sources-summary strong { display: block; font: 700 28px var(--font-display); }
  .sources-summary span { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; }

  @media (max-width: 820px) {
    .sources-intro { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 560px) {
    .sources-summary { gap: 18px; }
  }
</style>
